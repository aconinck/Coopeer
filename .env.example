# Copy to .env (git-ignored). CARTO basemap key: https://carto.com/ (restrict it to your domains in the CARTO dashboard).
EXPO_PUBLIC_CARTO_KEY=

# Supabase (database + phone login). Project Settings → API. Leave empty to run on demo data.
# The anon key is public by design; Row Level Security (supabase/migrations) protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
